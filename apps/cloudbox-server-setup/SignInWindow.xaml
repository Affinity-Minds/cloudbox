<Window x:Class="CloudBox.Server.Setup.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CloudBox sign-up" Width="720" Height="760" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="14,8">
      <TextBlock x:Name="AddressText" Foreground="#334155" TextTrimming="CharacterEllipsis" />
    </Border>
    <TextBlock x:Name="FallbackText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="16" Visibility="Collapsed" />
    <wv2:WebView2 x:Name="Web" />
  </DockPanel>
</Window>
