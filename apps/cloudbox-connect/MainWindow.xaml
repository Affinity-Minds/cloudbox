<Window x:Class="CloudBox.Connect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudBox Connect" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CloudBox Connect" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <!-- Screen 1: Tenant ID + email -->
        <StackPanel x:Name="CredentialsPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="Tenant ID" Margin="0,0,0,4" />
            <TextBox x:Name="TenantCodeBox" Margin="0,0,0,12" />
            <TextBlock Text="Email" Margin="0,0,0,4" />
            <TextBox x:Name="EmailBox" Margin="0,0,0,16" />
            <Button x:Name="SendCodeButton" Content="Send code" Height="36" Click="SendCodeButton_Click" />
        </StackPanel>

        <!-- Screen 2: six-box one-time code -->
        <StackPanel x:Name="CodePanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="Enter the 6-digit code we sent you" Margin="0,0,0,12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBox x:Name="Code1" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" Margin="0,0,6,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                <TextBox x:Name="Code2" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" Margin="0,0,6,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                <TextBox x:Name="Code3" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" Margin="0,0,6,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                <TextBox x:Name="Code4" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" Margin="0,0,6,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                <TextBox x:Name="Code5" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" Margin="0,0,6,0" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                <TextBox x:Name="Code6" Width="36" Height="44" MaxLength="6" TextAlignment="Center" FontSize="20" TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
            </StackPanel>
            <!-- Off-screen honeypot: a bot filling every field would populate this; the cloud enforces it, this is belt-and-suspenders (design/ux-patterns.md). -->
            <TextBox x:Name="HoneypotBox" Width="1" Height="1" Opacity="0" IsTabStop="False" />
            <Button x:Name="ResendButton" Content="Resend code" Height="32" Click="ResendButton_Click" />
        </StackPanel>

        <!-- Screen 3: device list + one big Connect button per row -->
        <DockPanel x:Name="DevicesPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="TenantBannerText" DockPanel.Dock="Top" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="NoDevicesText" DockPanel.Dock="Top" TextWrapping="Wrap" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                        <Border Background="{Binding PillColor}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding OnlinePill}" Foreground="White" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,4,0,8" Visibility="{Binding ExplanationVisibility}" />
                                    <Button Content="CONNECT" Height="36" Tag="{Binding DeviceId}" IsEnabled="{Binding CanConnect}" Click="ConnectButton_Click" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
            <Button x:Name="SignOutButton" Content="Sign out" Height="28" HorizontalAlignment="Right" Click="SignOutButton_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
