{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "box.affinity.ai.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../admin-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbox-db",
      "migrations_dir": "../../infra/cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "cloudbox-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEET_PRESENCE",
        "class_name": "FleetPresence"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // src/scheduled.ts's one hook list: WT-17's alerts evaluator (needs this 5-minute cadence) plus
  // WT-19's backup retention sweep (self-throttled to hourly inside the hook, since it is not
  // cheap enough to run every tick). One `triggers` block, one crons entry — add a new job as a
  // hook in scheduled.ts, never a second entry or block here.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "exports": {
    "FleetPresence": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "BUILD_SHA": "development",
    "BUILD_TIME": "development",
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "",
    "OPS_BASE_PATH": "/ops",
    "EMAIL_FROM": "no-reply@em.affinity.ai.in",
    "BOOTSTRAP_SUPER_ADMIN_EMAIL": "bootstrap@example.invalid"
  }
}
