{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "box.affinityminds.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../admin-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BUILD_SHA": "development",
    "BUILD_TIME": "development"
  }
}
