# Local development only. Copy to .dev.vars (gitignored). Never put production values here.
ENVIRONMENT=development
STAFF_AUTH_SECRET=dev-only-staff-change-me-0123456789abcdef0123
CUSTOMER_AUTH_SECRET=dev-only-customer-change-me-0123456789abcdef
# OPS_BASE_PATH=/ops   # the discreet staff console path (single segment)
OTP_DEV_ECHO=1
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_SUPER_ADMIN_PASSWORD=dev-only-initial-password
# ENTITLEMENT_SIGNING_JWK=   # generate with: node packages/licensing-contracts/scripts/generate-signing-key.ts 2>/dev/null
# PROVIDER_SECRETS_KEY=      # base64 of 32 random bytes: openssl rand -base64 32
